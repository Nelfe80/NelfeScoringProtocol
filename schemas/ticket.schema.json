{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelfeplay.com/scoring/schemas/ticket.schema.json",
  "title": "Ticket serveur (générique, SPEC v1.0 §5.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "device_id", "scope", "manifest_epoch", "issued_at", "expires_at", "nonce", "issuer_key_id", "signature"],
  "properties": {
    "ticket_id": { "type": "string", "minLength": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "scope": { "const": "scoring_session" },
    "manifest_epoch": { "type": "integer", "minimum": 0 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "minLength": 1 },
    "issuer_key_id": { "$ref": "#/$defs/sha256hex" },
    "signature": { "$ref": "#/$defs/b64url" }
  },
  "$defs": {
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "b64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
