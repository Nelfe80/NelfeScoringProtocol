{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelfeplay.com/scoring/schemas/passport.schema.json",
  "title": "Passeport de scoring certifié (SPEC v1.0 §5.2)",
  "$comment": "Empreintes = SHA-256 bruts : fichier pour core/mem/listener, buffer ROM game->data (ROM extraite) pour content. Méthode : wiki/empreintes-et-profils.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "session_id", "ticket", "game", "device", "identity", "listener", "software", "artifacts", "process", "timing", "sensitive", "metric", "progression", "local_check", "signature"],
  "properties": {
    "protocol": { "const": 1 },
    "session_id": { "$ref": "#/$defs/uuid" },
    "ticket": { "$ref": "https://nelfeplay.com/scoring/schemas/ticket.schema.json" },

    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["system_id", "rom_group", "engine", "ruleset", "profile_version", "manifest_commit", "profile_document_sha256"],
      "properties": {
        "system_id": { "type": "string" },
        "rom_group": { "type": "string" },
        "engine": { "enum": ["libretro", "mame_standalone", "fbneo_standalone"] },
        "ruleset": { "type": "string" },
        "profile_version": { "type": "integer", "minimum": 1 },
        "manifest_commit": { "type": "string" },
        "profile_document_sha256": { "$ref": "#/$defs/sha256hex" },
        "mode": { "type": "integer", "minimum": 0 },
        "difficulty": {
          "type": "object",
          "propertyNames": { "pattern": "^0x[0-9A-F]+$" },
          "additionalProperties": { "type": "integer" }
        }
      }
    },

    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "key_id", "key_type"],
      "properties": {
        "device_id": { "type": "string" },
        "key_id": { "$ref": "#/$defs/sha256hex" },
        "key_type": { "const": "ecdsa_p256" }
      },
      "comment": "trust_level est renseigné par le SERVEUR (account_devices), jamais déclaré ici."
    },

    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["player_ref", "session_player_id"],
      "properties": {
        "player_ref": { "type": ["string", "null"] },
        "session_player_id": { "type": ["string", "null"] }
      }
    },

    "listener": {
      "type": "object", "additionalProperties": false,
      "required": ["build", "start_sha256", "loaded_sha256", "end_sha256", "certification"],
      "properties": {
        "build": { "type": "string" },
        "start_sha256": { "$ref": "#/$defs/sha256hex" },
        "loaded_sha256": { "$ref": "#/$defs/sha256hex" },
        "end_sha256": { "$ref": "#/$defs/sha256hex" },
        "certification": { "type": "string" }
      }
    },

    "software": {
      "type": "object", "additionalProperties": false,
      "required": ["modules", "modules_digest"],
      "properties": {
        "modules": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "sha256"],
            "properties": {
              "role": { "enum": ["frontend", "listener", "real_core", "apiexpose", "emulatorlauncher", "gamescript_hook"] },
              "sha256": { "$ref": "#/$defs/sha256hex" }
            }
          }
        },
        "modules_digest": { "$ref": "#/$defs/sha256hex" },
        "apiexpose": { "type": "string", "maxLength": 120, "description": "Version d'APIExpose qui a mesure la partie (x.y.z, suivi eventuel de +build). Signee depuis la 1.8.24." },
        "wrapper_state": { "type": "string", "maxLength": 24, "description": "Etat du wrapper sur la borne au moment de la partie." }
      }
    },

    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["core", "content", "mem", "core_options_digest", "bios"],
      "properties": {
        "core": { "$ref": "#/$defs/hashTriple" },
        "content": { "$ref": "#/$defs/contentArtifact" },
        "mem": { "$ref": "#/$defs/hashTriple" },
        "core_options_digest": { "$ref": "#/$defs/sha256hex" },
        "forced_options": {
          "description": "Les reglages que le listener a substitues au chargement pour s'aligner sur le profil (cle=valeur;... trie). Vide ou absent : rien n'a ete force.",
          "type": "string", "maxLength": 4000
        },
        "bios": {
          "description": "Les BIOS que le profil exige, haches la ou le coeur les charge. none quand le profil n'en exige pas.",
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": {
            "mode": { "enum": ["none", "files", "vfs_observed", "os_observed"] },
            "files": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "sha256": { "anyOf": [ { "$ref": "#/$defs/sha256hex" }, { "type": "null" } ] }
                }
              }
            }
          }
        },
        "nvram": {
          "description": "Fichiers NVRAM du jeu, octets bruts : au lancement (start) et apres la fermeture (end).",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["file", "size", "start", "end"],
            "properties": {
              "file": { "type": "string", "minLength": 1, "maxLength": 200 },
              "size": { "type": "integer", "minimum": 0, "maximum": 65536 },
              "start": { "type": "string", "contentEncoding": "base64" },
              "end": { "type": "string", "contentEncoding": "base64" }
            }
          }
        }
      }
    },

    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["pid", "executable_sha256", "parent_pid", "created_at", "open_files"],
      "properties": {
        "pid": { "type": "integer", "minimum": 0 },
        "executable_sha256": { "description": "Informatif : la version du frontend n'entre pas dans la validite d'un score.", "anyOf": [ { "$ref": "#/$defs/sha256hex" }, { "type": "null" } ] },
        "parent_pid": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "open_files": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["role", "identity"],
            "properties": {
              "role": { "enum": ["content", "mem", "bios", "core"] },
              "identity": { "type": "string" }
            }
          }
        }
      }
    },

    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "ended_at", "monotonic_ms", "frame_count"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "monotonic_ms": { "type": "integer", "minimum": 0 },
        "frame_count": { "type": "integer", "minimum": 0 }
      }
    },

    "sensitive": {
      "type": "object", "additionalProperties": false,
      "required": ["cheats", "save_state_loaded", "resets", "rewind", "runahead", "fast_forward", "netplay", "continues"],
      "properties": {
        "cheats": { "type": "boolean" },
        "save_state_loaded": { "type": "boolean" },
        "resets": { "type": "integer", "minimum": 0 },
        "rewind": { "type": "boolean" },
        "runahead": { "type": "boolean" },
        "fast_forward": { "type": "boolean" },
        "netplay": { "type": "boolean" },
        "continues": { "type": "integer", "minimum": 0 },
        "impossible_inputs": {
          "description": "Images ou deux directions opposees (gauche+droite, haut+bas) etaient tenues ensemble sur le port 1. Aucun levier ne le fait ; au-dela d'une tolerance de rebond de contact, le score est refuse (runtime.impossible_inputs). Absent : listener anterieur, compte pour 0.",
          "type": "integer", "minimum": 0
        },
        "press_count": { "description": "Appuis releves sur le port 1 (duree connue). Information, jamais un motif de refus.", "type": "integer", "minimum": 0 },
        "press_frames_sum": { "description": "Somme des durees d'appui, en images.", "type": "integer", "minimum": 0 },
        "press_frames_sq": { "description": "Somme des carres des durees d'appui : la dispersion se calcule cote plateforme, sans conserver la serie.", "type": "integer", "minimum": 0 },
        "macro_repeats": {
          "description": "Le plus grand nombre de fois qu'une meme seconde d'entrees (64 images, au moins 6 changements et deux directions ou deux boutons d'action) a ete rejouee a l'identique sans chevauchement. Un joueur ne depasse pas 2 ou 3 ; un boitier programmable monte sans limite. A partir de 5, le score est SIGNALE (plausibility.macro_detected) : garde, visible du seul joueur, jamais classe ni ancre.",
          "type": "integer", "minimum": 0
        },
        "macro_windows": { "description": "Nombre de fenetres distinctes rejouees au moins cinq fois.", "type": "integer", "minimum": 0 }
      }
    },

    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "unit", "value", "ranking_direction", "result_source"],
      "properties": {
        "type": { "enum": ["score", "time", "distance", "level", "wins"] },
        "unit": { "type": "string" },
        "value": { "$ref": "#/$defs/decimalString" },
        "ranking_direction": { "enum": ["higher_better", "lower_better"] },
        "result_source": { "enum": ["final", "best", "max", "min"] }
      }
    },

    "progression": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoints", "checkpoints_digest"],
      "properties": {
        "checkpoints": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["t_ms", "frame", "metric", "event", "counters"],
            "properties": {
              "t_ms": { "type": "integer", "minimum": 0 },
              "frame": { "type": "integer", "minimum": 0 },
              "metric": { "$ref": "#/$defs/decimalString" },
              "event": { "type": "string" },
              "counters": { "type": "object", "additionalProperties": { "type": "integer" } }
            }
          }
        },
        "checkpoints_digest": { "$ref": "#/$defs/sha256hex" }
      }
    },

    "challenge": {
      "$comment": "Défi chronométré (règlement nelfe.challenge.v2) : la tentative classée. Absent d'un passeport de score. Aucun nombre décimal : la cadence s'écrit en millionièmes.",
      "type": "object", "additionalProperties": false,
      "required": ["challenge_id", "version", "attempt_number", "start_policy", "timing", "events", "splits", "boards"],
      "properties": {
        "challenge_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$" },
        "version": { "type": "integer", "minimum": 1 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "start_policy": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "state_sha256": { "$ref": "#/$defs/sha256hex" },
        "timing": {
          "type": "object", "additionalProperties": false,
          "required": ["official", "aligned", "independent", "excluded", "game_time_seconds", "game_time_check", "clock_ms", "frame_rate_e6"],
          "properties": {
            "official": { "enum": ["game_timer_aligned", "independent"] },
            "aligned": { "oneOf": [{ "$ref": "#/$defs/challengeChrono" }, { "type": "null" }] },
            "independent": { "oneOf": [{ "$ref": "#/$defs/challengeChrono" }, { "type": "null" }] },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["from_frame", "to_frame"],
                "properties": {
                  "from_frame": { "type": "integer", "minimum": 0 },
                  "to_frame": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "game_time_seconds": { "type": ["integer", "null"], "minimum": 0 },
            "game_time_check": { "enum": ["ok", "jeu_en_retard", "ecart", "non_mesure"] },
            "clock_ms": { "type": "integer", "minimum": 0 },
            "frame_rate_e6": { "type": "integer", "minimum": 1 }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "action", "address", "value", "frame"],
            "properties": {
              "role": { "type": "string" },
              "action": { "type": "string" },
              "address": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
              "value": { "type": "integer" },
              "frame": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "splits": { "type": "array" },
        "boards": { "type": "array", "items": { "type": "string" } }
      }
    },

    "local_check": { "type": "string" },
    "signature": { "$ref": "#/$defs/b64url" }
  },

  "$defs": {
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "md5hex": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "sha1hex": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "b64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "decimalString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "challengeChrono": {
      "$comment": "Un chrono d'une tentative, en images de la borne : frames = fin - début - plages exclues. Null tant qu'une borne n'est pas vue.",
      "type": "object", "additionalProperties": false,
      "required": ["start_frame", "end_frame", "frames"],
      "properties": {
        "start_frame": { "type": ["integer", "null"], "minimum": 0 },
        "end_frame": { "type": ["integer", "null"], "minimum": 0 },
        "frames": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "hashTriple": {
      "type": "object", "additionalProperties": false,
      "required": ["start_sha256", "loaded_sha256", "end_sha256"],
      "properties": {
        "start_sha256": { "$ref": "#/$defs/sha256hex" },
        "loaded_sha256": { "$ref": "#/$defs/sha256hex" },
        "end_sha256": { "$ref": "#/$defs/sha256hex" }
      }
    },
    "contentArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["start_sha256", "loaded_sha256", "end_sha256"],
      "properties": {
        "start_sha256": { "$ref": "#/$defs/sha256hex" },
        "loaded_sha256": { "$ref": "#/$defs/sha256hex" },
        "end_sha256": { "$ref": "#/$defs/sha256hex" },
        "md5": { "$ref": "#/$defs/md5hex" },
        "sha1": { "$ref": "#/$defs/sha1hex" }
      }
    }
  }
}
