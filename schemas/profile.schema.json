{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelfeplay.com/scoring/schemas/profile.schema.json",
  "title": "Profil de scoring - manifeste (SPEC v1.0 §8)",
  "$comment": "ATTENTION : les fichiers manifest/profiles/**/N.json sont des FIXTURES générés (SHA de libellés) — ne JAMAIS déposer en prod. Vrais profils : NelfePlay-Site/config/scoring-profiles/. Voir wiki/empreintes-et-profils.md et manifest/profiles/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["system_id", "rom_group", "engine", "ruleset", "version", "manifest_epoch", "published_at", "opened_at", "metric", "trajectory_policy", "allowed_core_sha256", "allowed_listener_sha256", "mem_sha256", "bios", "rules", "correlation_rules"],
  "anyOf": [
    { "required": ["allowed_content_sha256"] },
    { "required": ["allowed_content_md5"] },
    { "required": ["allowed_content_sha1"] }
  ],
  "properties": {
    "system_id": { "type": "string" },
    "rom_group": { "type": "string" },
    "engine": { "enum": ["libretro", "mame_standalone", "fbneo_standalone"] },
    "ruleset": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "manifest_epoch": { "type": "integer", "minimum": 0 },
    "published_at": { "type": "string", "format": "date-time" },
    "opened_at": { "type": "string", "format": "date-time" },

    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "unit", "ranking_direction", "result_source"],
      "properties": {
        "type": { "enum": ["score", "time", "distance", "level", "wins"] },
        "unit": { "type": "string" },
        "ranking_direction": { "enum": ["higher_better", "lower_better"] },
        "result_source": { "enum": ["final", "best", "max", "min"] }
      }
    },
    "trajectory_policy": {
      "type": "object", "additionalProperties": false, "required": ["monotonicity"],
      "properties": { "monotonicity": { "enum": ["non_decreasing", "non_increasing", "free"] } }
    },

    "allowed_content_sha256": { "$ref": "#/$defs/sha256Array" },
    "allowed_content_md5": { "$ref": "#/$defs/md5Array" },
    "allowed_content_sha1": { "$ref": "#/$defs/sha1Array" },
    "allowed_core_sha256": { "$ref": "#/$defs/sha256Array" },
    "allowed_listener_sha256": { "$ref": "#/$defs/sha256Array" },
    "allowed_modules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha256Array" }
    },
    "mem_sha256": { "$ref": "#/$defs/sha256hex" },

    "bios": {
      "description": "none : le jeu n'utilise pas de BIOS, rien a controler. files : les BIOS exiges, par nom de fichier, et leurs empreintes autorisees.",
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "files", "vfs_observed", "os_observed"] },
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "allowed_sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "allowed_sha256": { "$ref": "#/$defs/sha256Array" },
              "cores": { "description": "Coeurs concernes (sha256 du coeur charge). Absent : tous.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256hex" } }
            }
          }
        }
      },
      "if": { "properties": { "mode": { "const": "files" } } },
      "then": { "required": ["mode", "files"] }
    },

    "core_options_policy": { "type": "object" },
    "allowed_core_options_digest": { "$ref": "#/$defs/sha256Array" },
    "core_options_expected": {
      "description": "Les reglages certifies EN CLAIR, par moteur. Une empreinte ne se remonte pas : sans les valeurs, la borne ne peut ni dire au joueur ce qui cloche, ni le corriger avant la partie. Le listener repond ces valeurs au coeur au chargement quand la borne force la certification ; l'empreinte reste le controle.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["values"],
        "properties": {
          "values": {
            "description": "cle d'option (libretro) ou nom de DIP switch (MAME autonome) -> valeur attendue.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "maxLength": 200 }
          },
          "cores": {
            "description": "Coeurs auxquels ces valeurs s'appliquent (sha256 du coeur charge). Absent : tous.",
            "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256hex" }
          }
        }
      }
    },
    "autofire": {
      "description": "Ce que le tir automatique veut dire pour CE jeu. Des appuis d'une regularite mecanique sont une information, jamais une anomalie ; l'attribut dit comment la lire. original : le jeu ou sa borne d'epoque l'avait, il ne se signale pas. added : le jeu ne l'avait pas, le repere le dit (autofire_added). not_applicable : la cadence des appuis ne veut rien dire ici (puzzle, beat'em up), rien ne se signale. Absent : repere generique autofire.",
      "enum": ["original", "added", "not_applicable"]
    },
    "nvram_pins": {
      "description": "Reglages des jeux sans DIP switches (EEPROM, RAM de sauvegarde) : plages d'octets calibrees par jeu et leur empreinte. Opt-in.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "ranges", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1, "maxLength": 200 },
          "ranges": {
            "type": "array", "minItems": 1,
            "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }
          },
          "sha256": { "$ref": "#/$defs/sha256hex" },
          "cores": {
            "description": "Coeurs auxquels l'epingle s'applique (sha256 du coeur charge). Absent : tous. Un profil multi-moteurs epingle le fichier de CHAQUE moteur a part.",
            "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256hex" }
          }
        }
      }
    },

    "rules": {
      "type": "object", "additionalProperties": false,
      "required": ["save_state", "cheats", "rewind", "runahead", "continues", "players"],
      "properties": {
        "save_state": { "enum": ["forbidden", "allowed"] },
        "cheats": { "enum": ["forbidden", "allowed"] },
        "rewind": { "enum": ["forbidden", "allowed"] },
        "runahead": { "enum": ["forbidden", "allowed"] },
        "fast_forward": { "enum": ["forbidden", "allowed"] },
        "continues": { "enum": ["forbidden", "allowed"] },
        "players": { "type": "integer", "minimum": 1 }
      }
    },

    "correlation_rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["event"],
        "properties": {
          "event": { "type": "string" },
          "requires": { "$ref": "#/$defs/tokens" },
          "requires_any": { "$ref": "#/$defs/tokens" }
        },
        "anyOf": [ { "required": ["requires"] }, { "required": ["requires_any"] } ]
      }
    },

    "plausibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_delta_per_event": { "type": ["string", "integer"] },
        "hold_threshold": { "type": ["string", "integer"] },
        "hold_max_hours": { "type": "integer", "minimum": 0 },
        "min_sessions_for_record": { "type": "integer", "minimum": 0 }
      }
    },

    "test_vectors_ref": { "type": "string" }
  },

  "$defs": {
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256Array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256hex" } },
    "md5hex": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "md5Array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/md5hex" } },
    "sha1hex": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha1Array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha1hex" } },
    "tokens": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["score_delta", "rings_delta", "level_delta", "lives_delta", "time_checkpoint"] }
    }
  }
}
